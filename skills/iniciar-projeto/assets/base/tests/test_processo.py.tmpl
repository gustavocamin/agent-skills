def test_agents_md_cabe_no_contexto_e_tem_as_secoes():
    # O Codex lê até 32 KiB de AGENTS.md por padrão; o Claude Code recomenda menos de 200 linhas.
    caminho = ROOT / "AGENTS.md"
    assert caminho.stat().st_size <= 32 * 1024
    conteudo = caminho.read_text(encoding="utf-8")
    assert len(conteudo.splitlines()) <= 200
    for secao in SECOES_AGENTS:
        assert _tem_secao(conteudo, secao), secao


def test_claude_importa_o_agents_uma_vez_sem_repetir_regras():
    conteudo = _ler("CLAUDE.md")
    assert conteudo.splitlines()[0] == "@AGENTS.md"
    fora_de_blocos = re.sub(r"(?ms)^```.*?^```\s*", "", conteudo)
    assert fora_de_blocos.count("@AGENTS.md") == 1
    # O que vale para os dois agentes mora no AGENTS.md; o CLAUDE.md fica curto.
    for repetido in ("## Invariantes", "### Protocolo", "handoff(Fxx-gN)"):
        assert repetido not in conteudo, repetido
    assert len(conteudo.splitlines()) <= 40


def test_skills_do_fluxo_tem_metadados_e_usam_o_agents():
    pasta = ROOT / ".claude" / "skills"
    nomes = _skills_do_repo(pasta)
    assert SKILLS <= nomes
    for nome in nomes:
        conteudo = (pasta / nome / "SKILL.md").read_text(encoding="utf-8")
        frontmatter = conteudo.split("---", 2)
        assert len(frontmatter) == 3 and not frontmatter[0].strip(), nome
        assert re.search(rf"(?m)^name: {re.escape(nome)}$", frontmatter[1]), nome
        descricao = re.search(r"(?m)^description: (\S.*)$", frontmatter[1])
        assert descricao and _yaml_simples(descricao.group(1)), nome
        assert "AGENTS.md" in conteudo, nome
        # As regras vêm do AGENTS.md: o outro agente não lê o CLAUDE.md.
        assert not re.search(r"(?i)(?:leia|ler|consulte)\s+(?:o\s+)?[`\"']?CLAUDE\.md", conteudo), (
            nome
        )
