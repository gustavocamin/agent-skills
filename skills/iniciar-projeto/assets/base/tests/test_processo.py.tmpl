def _linhas_de_dono(conteudo: str, origem: str) -> list[tuple[str, str]]:
    titulos = re.findall(r"(?m)^### Grupo\b.*$", conteudo)
    assert titulos, f"{origem}: sem grupos"
    grupos = []
    for titulo in titulos:
        numero = re.match(r"### Grupo (\d+) — \S", titulo)
        assert numero, f"{origem}: título fora do formato '### Grupo N — <nome>': {titulo}"
        depois = conteudo.split(titulo + "\n", 1)[1].lstrip("\n")
        grupos.append((numero.group(1), depois.splitlines()[0] if depois else ""))
    return grupos


