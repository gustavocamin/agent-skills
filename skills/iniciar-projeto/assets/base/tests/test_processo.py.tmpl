)


def _ler(relativo: str) -> str:
    return (ROOT / relativo).read_text(encoding="utf-8")


def _tem_secao(conteudo: str, titulo: str) -> bool:
    return re.search(rf"(?m)^{re.escape(titulo)}\b", conteudo) is not None


def _blocos_handoff(conteudo: str) -> list[str]:
    # Blocos cercados, na coluna 0, que começam pelo assunto do handoff.
    return re.findall(r"(?ms)^```(?:text)?\nhandoff\(Fxx-gN\).*?^```", conteudo)


def _yaml_simples(valor: str) -> bool:
    # Valor YAML sem aspas: não começa por indicador, não tem ": " nem " #", não termina em ":".
    return not (
        valor[:1] in "`'\"[]{}>|*&!%@#-?:," or ": " in valor or " #" in valor or valor.endswith(":")
    )


def _skills_do_repo(pasta: Path) -> set[str]:
    # Só as skills do repo: uma pasta que o git ignora (como as skills pessoais que o setup de um
    # ambiente cloud instala ali e põe no .git/info/exclude) não é do projeto.
    nomes = {item.name for item in pasta.iterdir() if item.is_dir()}
    ignoradas = subprocess.run(
        ["git", "check-ignore", "--no-index", *(f"{pasta.name}/{nome}/" for nome in nomes)],
        cwd=pasta.parent,
        capture_output=True,
        text=True,
        check=False,
    )
    if ignoradas.returncode > 1:  # fora de um repo git: vale a pasta inteira
        return nomes
    return nomes - {Path(linha).name for linha in ignoradas.stdout.split()}


def test_constituicao_e_template_de_feature_existem():
    for nome in ("mission.md", "tech_stack.md", "roadmap.md"):
        assert (ROOT / "specs" / "constitution" / nome).is_file(), nome
