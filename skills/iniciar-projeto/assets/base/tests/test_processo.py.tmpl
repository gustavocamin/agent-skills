    assert perfil["network"]["enabled"] is True
    assert perfil["network"]["domains"] == {
        "pypi.org": "allow",
        "files.pythonhosted.org": "allow",
        "registry.npmjs.org": "allow",
    }
    negados = ["~/.config/{{SLUG}}", "~/.config/gh", "~/.codex/auth.json"]
