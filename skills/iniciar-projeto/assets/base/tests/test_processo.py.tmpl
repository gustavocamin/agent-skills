# Arquivos que só quem integra escreve: nenhum grupo os põe no Toca.
DE_QUEM_INTEGRA = ("start_here.md", "specs/constitution")
SEGREDOS = re.compile(
    r"dapi[0-9a-f]{32}"  # token pessoal da Databricks
    r"|gh[pousr]_[A-Za-z0-9]{36}"  # token do GitHub
    r"|github_pat_[A-Za-z0-9_]{22,}"  # token fino do GitHub
    r"|sk-[A-Za-z0-9_-]{32,}"  # chaves da Anthropic (sk-ant-) e da OpenAI (sk-proj-)
    r"|AKIA[0-9A-Z]{16}"  # chave de acesso da AWS
