    ("git push --all", "prompt"),
    ("git push --receive-pack=/tmp/x origin HEAD:y", "prompt"),
    ("git push", "prompt"),
    ("git commit -m handoff", "allow"),
    ("git commit -a -m handoff", "allow"),
    ("git switch -c feature/F01-x--g1-codex", "allow"),
    ("pytest -q", None),
]


def _regras() -> list[dict]:
    # O arquivo é Starlark com sintaxe de Python: cada prefix_rule(...) só tem literais.
    regras = []
    for no in ast.walk(ast.parse(_ler(REGRAS))):
        if isinstance(no, ast.Call) and getattr(no.func, "id", None) == "prefix_rule":
            regras.append({kw.arg: ast.literal_eval(kw.value) for kw in no.keywords})
    return regras


def _casa(padrao: list, comando: str) -> bool:
    # Como o Codex: casa por prefixo de tokens; uma lista é a união de alternativas naquela posição.
    tokens = comando.split()
    return len(tokens) >= len(padrao) and all(
        token in parte if isinstance(parte, list) else token == parte
        for parte, token in zip(padrao, tokens)
    )


def _decisao(comando: str) -> str | None:
    # Entre as regras que casam, vale a mais restritiva.
    decisoes = [
        regra.get("decision", "allow") for regra in _regras() if _casa(regra["pattern"], comando)
    ]
    return max(decisoes, key=RIGOR.__getitem__, default=None)


@pytest.mark.parametrize(("comando", "esperado"), EXPECTED_DECISIONS)
def test_regras_do_codex_decidem_cada_comando(comando, esperado):
    assert _decisao(comando) == esperado


def test_exemplos_das_regras_batem_com_o_padrao():
    # O Codex valida match e not_match ao carregar; aqui eles valem também no CI, sem o Codex.
    for regra in _regras():
        for exemplo in regra.get("match", []):
            assert _casa(regra["pattern"], exemplo), exemplo
        for exemplo in regra.get("not_match", []):
            assert not _casa(regra["pattern"], exemplo), exemplo


@pytest.mark.skipif(shutil.which("codex") is None, reason="Codex CLI não instalado (CI)")
def test_tabela_bate_com_o_execpolicy_do_codex():
    # Confere o avaliador acima contra o próprio Codex, quando ele está na máquina.
    for comando, esperado in EXPECTED_DECISIONS:
        saida = subprocess.run(
            ["codex", "execpolicy", "check", "--rules", str(ROOT / REGRAS), "--", *comando.split()],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
        assert json.loads(saida).get("decision") == esperado, comando


