RIGOR = {"allow": 0, "prompt": 1, "forbidden": 2}

# Decisão esperada por comando. None: nenhuma regra casa, e vale o sandbox.
EXPECTED_DECISIONS = [
{{#se databricks}}
    ("databricks apps delete meu-app --profile p", "forbidden"),
    ("databricks postgres delete-project projects/x", "forbidden"),
    ("databricks postgres delete-branch projects/x/branches/y", "forbidden"),
    ("databricks apps get meu-app --profile p", "prompt"),
    ("databricks postgres list-branches projects/x", "prompt"),
{{/se}}
    ("git push --force origin feature/F01-x--g2-codex", "forbidden"),
    ("git push -f", "forbidden"),
    ("git push --mirror", "forbidden"),
    ("git push origin --force-with-lease feature/x", "forbidden"),
    ("git push origin main", "forbidden"),
    ("git push origin HEAD:main", "forbidden"),
    ("git push origin +main", "forbidden"),
    ("git push origin :main", "forbidden"),
    ("git push -u origin main", "forbidden"),
    ("git push origin HEAD:refs/heads/main", "forbidden"),
    ("git add -f .env", "forbidden"),
    ("git add --force .env", "forbidden"),
    ("gh pr create --base feature/F01-x", "prompt"),
    ("git push origin --delete feature/F01-x--g1-codex", "prompt"),
    ("git push --delete origin feature/F01-x--g1-codex", "prompt"),
    ("git add tests/test_processo.py", "prompt"),
    ("git add -fA", "prompt"),
    # Todo push pede aprovação: com "allow", estes rodariam fora do sandbox.
    ("git push -u origin feature/F01-x--g1-codex", "prompt"),
