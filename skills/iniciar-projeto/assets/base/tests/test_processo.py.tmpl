        assert "Toca: `" in linha, f"template: Grupo {numero} sem Toca"


def test_planos_declaram_integra_dono_branch_e_toca():
    for pasta in sorted((ROOT / "specs" / "features").glob("F*")):
        if not pasta.is_dir():
            continue
        assert re.fullmatch(r"F\d{2,}-[a-z0-9]+(?:-[a-z0-9]+)*", pasta.name), (
            f"{pasta.name}: nome fora de Fxx-nome"
        )
        conteudo = (pasta / "plan.md").read_text(encoding="utf-8")
        assert re.search(r"(?m)^Integra: (Claude Code|Codex)$", conteudo), (
            f"{pasta.name}: sem a linha Integra"
        )
        for numero, linha in _linhas_de_dono(conteudo, pasta.name):
            dono = DONO.match(linha)
            assert dono, f"{pasta.name}: Grupo {numero} sem dono válido logo abaixo do título"
            toca = re.search(r"Toca: (`[^`]+`.*)$", linha)
            assert toca, f"{pasta.name}: Grupo {numero} sem Toca"
            for arquivo in DE_QUEM_INTEGRA:
                assert arquivo not in toca.group(1), f"{pasta.name}: Grupo {numero} toca {arquivo}"
            branch = re.search(r"Branch: `([^`]+)`", linha)
            assert "Branch:" not in linha or branch, (
                f"{pasta.name}: Grupo {numero} com branch inválida"
            )
            if branch:
                sufixo = "claude" if dono.group(1) == "Claude Code" else "codex"
                assert branch.group(1) == f"feature/{pasta.name}--g{numero}-{sufixo}"


def test_specs_das_features_seguem_o_template():
    # Spec fora do template é difícil de conferir e de retomar.
    for pasta in sorted((ROOT / "specs" / "features").glob("F*")):
        if not pasta.is_dir():
            continue
        for arquivo, obrigatorias in SECOES_SPEC.items():
            caminho = pasta / arquivo
            assert caminho.is_file(), f"{pasta.name}: falta {arquivo}"
            conteudo = caminho.read_text(encoding="utf-8")
            for secao in obrigatorias:
                assert _tem_secao(conteudo, secao), f"{pasta.name}/{arquivo}: falta {secao}"
        validacao = (pasta / "validation.md").read_text(encoding="utf-8")
        assert re.search(r"(?m)^\| Grupo \|.*\| Handoff conferido \|", validacao), pasta.name


def test_decisoes_do_roadmap_datadas_e_a_mais_nova_em_cima():
    conteudo = _ler("specs/constitution/roadmap.md")
    secao = conteudo.split("\n## Decisões\n", 1)[1].split("\n## ", 1)[0]
    assert not re.search(r"(?m)^[*+] ", secao), "Decisões: use '- ' no começo de cada entrada"
    entradas = re.findall(r"(?m)^- (.*)$", secao)
    assert entradas, "Decisões sem nenhuma entrada"
    datas = []
    for entrada in entradas:
        data = re.match(r"(\d{4}-\d{2}-\d{2}) — ", entrada)
        assert data, f"Decisão sem data AAAA-MM-DD no começo: {entrada[:60]}"
        datas.append(date.fromisoformat(data.group(1)))
    assert datas == sorted(datas, reverse=True), "Decisões fora de ordem: a mais nova vai em cima"


